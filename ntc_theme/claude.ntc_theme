tree_size = { r = 103, g = 97, b = 88 }
command_output = { r = 31, g = 30, b = 27 }
separator = { r = 202, g = 188, b = 170 }
help_header = { r = 46, g = 94, b = 140 }
help_section = { r = 169, g = 71, b = 40 }
help_example = { r = 79, g = 107, b = 58 }
teleport_name = { r = 46, g = 94, b = 140 }
alias_name = { r = 169, g = 71, b = 40 }
alias_command = { r = 106, g = 101, b = 92 }
git_branch = { r = 46, g = 94, b = 140 }
