warning = { r = 255, g = 218, b = 110 }
info = { r = 105, g = 225, b = 255 }
muted = { r = 136, g = 147, b = 160 }
table_header = { r = 190, g = 150, b = 255 }
table_border = { r = 49, g = 33, b = 43 }
