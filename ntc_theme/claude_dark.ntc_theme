txtf_file = { r = 228, g = 216, b = 200 }
ral_name = { r = 232, g = 149, b = 110 }
ral_command = { r = 227, g = 190, b = 122 }
ntc_sub_command = { r = 154, g = 184, b = 216 }
sub_sub_command = { r = 140, g = 201, b = 184 }
flag1 = { r = 227, g = 190, b = 122 }
