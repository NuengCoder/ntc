# claude - Warm parchment theme with terracotta, ink, olive, and clay accents.
# ntc theme. Install with: ntc theme import ntc_theme/claude.ntc_theme

name = "claude"
author = "ntc"
description = "Warm parchment theme with terracotta, ink, olive, and clay accents"

[syntax]
keyword = { r = 169, g = 71, b = 40 }
string = { r = 79, g = 107, b = 58 }
comment = { r = 106, g = 101, b = 92 }
number = { r = 125, g = 79, b = 0 }
type = { r = 46, g = 94, b = 140 }
builtin = { r = 123, g = 74, b = 143 }
function = { r = 44, g = 110, b = 99 }
operator = { r = 91, g = 86, b = 77 }
punctuation = { r = 107, g = 101, b = 91 }
attribute = { r = 125, g = 79, b = 0 }
macro_token = { r = 169, g = 71, b = 40 }
regex = { r = 179, g = 38, b = 30 }
tag = { r = 46, g = 94, b = 140 }
constant = { r = 125, g = 79, b = 0 }
normal = { r = 31, g = 30, b = 27 }
muted = { r = 106, g = 101, b = 92 }
table_header = { r = 46, g = 94, b = 140 }
table_border = { r = 216, g = 204, b = 188 }
line_number = { r = 106, g = 101, b = 92 }

[shell]
prompt_bracket = { r = 46, g = 94, b = 140 }
prompt_path = { r = 169, g = 71, b = 40 }
prompt_watcher = { r = 125, g = 79, b = 0 }
