ntc_command = { r = 125, g = 79, b = 0 }
txtf_file = { r = 61, g = 58, b = 52 }
ral_name = { r = 169, g = 71, b = 40 }
ral_command = { r = 125, g = 79, b = 0 }
ntc_sub_command = { r = 46, g = 94, b = 140 }
sub_sub_command = { r = 44, g = 110, b = 99 }
flag1 = { r = 125, g = 79, b = 0 }
flag2 = { r = 107, g = 101, b = 91 }
tp_name = { r = 46, g = 94, b = 140 }
tp_path = { r = 169, g = 71, b = 40 }
ral_ls_alias = { r = 46, g = 94, b = 140 }
tp_ls_tp_name = { r = 46, g = 94, b = 140 }
