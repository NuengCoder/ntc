  view -ext, --ext <ext...>              Show tree with only matching extensions
  view -cp, --copy                       Show tree and copy to clipboard
  view -d, --depth <n>                   Show tree with custom depth
  view -c, --care                        Show tree with care everything
  view --time, -t                        Show tree with execution time
  view -p, --path <path|@tp|@tp/sub>     Show tree of a path or teleport path
Examples:
    view                                   # Show directory tree
    view --size                            # Show tree with sizes
    view -d 2                              # Show tree with depth 2
    view -cp                               # Show tree and copy to clipboard
    view --time                            # Show tree with execution time
    view -p C:\code\project                # Show tree of a specific path
    view @web                              # Show tree of a teleport savepoint
    view -s 10MB                           # Only files/dirs at least 10MB
    view --sort size --head 20             # 20 largest entries first
    view main.rs --tail 30                 # Last 30 lines of main.rs
    view main.rs --betw 10:20              # Lines 10-20 of main.rs
    view @docs/readme.md                   # Display a teleport savepoint file
