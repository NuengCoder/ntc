# ocean - Deep ocean blue dark theme.
# ntc theme. Install with: ntc theme import ntc_theme/ocean.ntc_theme

name = "ocean"
author = "ntc"
description = "Deep ocean blue dark theme"

[syntax]
keyword = { r = 143, g = 184, b = 224 }
string = { r = 159, g = 196, b = 176 }
comment = { r = 98, g = 112, b = 127 }
number = { r = 208, g = 184, b = 144 }
type = { r = 143, g = 191, b = 208 }
builtin = { r = 208, g = 152, b = 168 }
function = { r = 160, g = 192, b = 232 }
operator = { r = 170, g = 182, b = 195 }
punctuation = { r = 141, g = 154, b = 168 }
attribute = { r = 208, g = 184, b = 144 }
macro_token = { r = 166, g = 173, b = 204 }
regex = { r = 208, g = 163, b = 160 }
tag = { r = 143, g = 191, b = 208 }
constant = { r = 208, g = 184, b = 144 }
normal = { r = 194, g = 206, b = 218 }
muted = { r = 98, g = 112, b = 127 }
table_header = { r = 143, g = 191, b = 208 }
table_border = { r = 78, g = 90, b = 104 }
line_number = { r = 98, g = 112, b = 127 }

