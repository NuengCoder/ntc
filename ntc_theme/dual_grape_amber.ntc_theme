# dual_grape_amber - Dual-accent grape and amber theme with a warm aubergine editor.
# ntc theme. Install with: ntc theme import ntc_theme/dual_grape_amber.ntc_theme

name = "dual_grape_amber"
author = "ntc"
description = "Dual-accent grape and amber theme with a warm aubergine editor"

[syntax]
keyword = { r = 217, g = 166, b = 255 }
string = { r = 180, g = 230, b = 152 }
comment = { r = 169, g = 149, b = 176 }
number = { r = 255, g = 206, b = 124 }
type = { r = 255, g = 201, b = 117 }
builtin = { r = 255, g = 154, b = 137 }
function = { r = 231, g = 195, b = 255 }
operator = { r = 218, g = 206, b = 224 }
punctuation = { r = 193, g = 178, b = 201 }
attribute = { r = 255, g = 206, b = 124 }
macro_token = { r = 217, g = 166, b = 255 }
regex = { r = 241, g = 187, b = 176 }
tag = { r = 255, g = 201, b = 117 }
constant = { r = 255, g = 206, b = 124 }
normal = { r = 242, g = 235, b = 245 }
muted = { r = 169, g = 149, b = 176 }
table_header = { r = 255, g = 201, b = 117 }
table_border = { r = 60, g = 45, b = 67 }
line_number = { r = 169, g = 149, b = 176 }

[shell]
prompt_bracket = { r = 255, g = 201, b = 117 }
prompt_path = { r = 217, g = 166, b = 255 }
prompt_watcher = { r = 255, g = 206, b = 124 }
prompt_arrow = { r = 180, g = 230, b = 152 }
ntc_command = { r = 255, g = 206, b = 124 }
txtf_file = { r = 180, g = 230, b = 152 }
ral_name = { r = 217, g = 166, b = 255 }
ral_command = { r = 255, g = 206, b = 124 }
ntc_sub_command = { r = 255, g = 201, b = 117 }
sub_sub_command = { r = 231, g = 195, b = 255 }
flag1 = { r = 255, g = 206, b = 124 }
flag2 = { r = 193, g = 178, b = 201 }
tp_name = { r = 255, g = 201, b = 117 }
tp_path = { r = 217, g = 166, b = 255 }
ral_ls_alias = { r = 255, g = 201, b = 117 }
tp_ls_tp_name = { r = 255, g = 201, b = 117 }
success = { r = 217, g = 166, b = 255 }
error = { r = 255, g = 154, b = 137 }
warning = { r = 255, g = 206, b = 124 }
info = { r = 255, g = 201, b = 117 }
muted = { r = 169, g = 149, b = 176 }
table_header = { r = 217, g = 166, b = 255 }
table_border = { r = 60, g = 45, b = 67 }
line_number = { r = 169, g = 149, b = 176 }
tree_branch = { r = 160, g = 128, b = 170 }
tree_dir = { r = 255, g = 201, b = 117 }
tree_file = { r = 215, g = 199, b = 181 }
tree_ignored = { r = 169, g = 149, b = 176 }
tree_size = { r = 169, g = 149, b = 176 }
command_output = { r = 242, g = 235, b = 245 }
separator = { r = 69, g = 50, b = 77 }
help_header = { r = 255, g = 201, b = 117 }
help_section = { r = 217, g = 166, b = 255 }
help_example = { r = 180, g = 230, b = 152 }
teleport_name = { r = 255, g = 201, b = 117 }
alias_name = { r = 231, g = 195, b = 255 }
alias_command = { r = 169, g = 149, b = 176 }
git_branch = { r = 255, g = 201, b = 117 }
git_added = { r = 217, g = 166, b = 255 }
git_modified = { r = 255, g = 206, b = 124 }
git_deleted = { r = 255, g = 154, b = 137 }
git_untracked = { r = 193, g = 178, b = 201 }
