# claude_dark - Dark warm variant of the Claude theme with terracotta, cream, olive, and plum accents.
# ntc theme. Install with: ntc theme import ntc_theme/claude_dark.ntc_theme

name = "claude_dark"
author = "ntc"
description = "Dark warm variant of the Claude theme with terracotta, cream, olive, and plum accents"

[syntax]
keyword = { r = 232, g = 149, b = 110 }
string = { r = 167, g = 201, b = 138 }
comment = { r = 179, g = 158, b = 136 }
number = { r = 227, g = 190, b = 122 }
type = { r = 154, g = 184, b = 216 }
builtin = { r = 201, g = 160, b = 216 }
function = { r = 140, g = 201, b = 184 }
operator = { r = 216, g = 200, b = 184 }
punctuation = { r = 185, g = 168, b = 147 }
attribute = { r = 227, g = 190, b = 122 }
macro_token = { r = 232, g = 149, b = 110 }
regex = { r = 232, g = 139, b = 130 }
tag = { r = 154, g = 184, b = 216 }
constant = { r = 227, g = 190, b = 122 }
normal = { r = 242, g = 233, b = 221 }
muted = { r = 179, g = 158, b = 136 }
table_header = { r = 154, g = 184, b = 216 }
table_border = { r = 58, g = 45, b = 35 }
line_number = { r = 179, g = 158, b = 136 }

[shell]
prompt_bracket = { r = 154, g = 184, b = 216 }
prompt_path = { r = 232, g = 149, b = 110 }
