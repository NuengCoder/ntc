[editor]
editor_bg = { r = 28, g = 20, b = 32 }
gutter_bg = { r = 20, g = 14, b = 24 }
status_bg = { r = 76, g = 44, b = 84 }
hint_bg = { r = 17, g = 12, b = 20 }
text_field_bg = { r = 52, g = 40, b = 58 }
sidebar_bg = { r = 18, g = 12, b = 22 }
