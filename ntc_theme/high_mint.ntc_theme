# high_mint - Luminous mint theme with high-brightness accents.
# ntc theme. Install with: ntc theme import ntc_theme/high_mint.ntc_theme

name = "high_mint"
author = "ntc"
description = "Luminous mint theme with high-brightness accents"

[syntax]
keyword = { r = 157, g = 225, b = 200 }
string = { r = 163, g = 219, b = 163 }
comment = { r = 148, g = 168, b = 162 }
number = { r = 225, g = 200, b = 158 }
type = { r = 163, g = 220, b = 212 }
builtin = { r = 224, g = 158, b = 167 }
function = { r = 165, g = 218, b = 214 }
operator = { r = 180, g = 202, b = 196 }
punctuation = { r = 183, g = 199, b = 194 }
attribute = { r = 225, g = 200, b = 158 }
macro_token = { r = 181, g = 202, b = 189 }
regex = { r = 223, g = 169, b = 160 }
tag = { r = 163, g = 220, b = 212 }
constant = { r = 225, g = 200, b = 158 }
normal = { r = 200, g = 218, b = 213 }
muted = { r = 148, g = 168, b = 162 }
table_header = { r = 163, g = 220, b = 212 }
table_border = { r = 74, g = 94, b = 88 }
line_number = { r = 148, g = 168, b = 162 }

[shell]
prompt_bracket = { r = 163, g = 220, b = 212 }
prompt_path = { r = 165, g = 218, b = 214 }
prompt_watcher = { r = 225, g = 200, b = 158 }
