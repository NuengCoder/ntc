error = { r = 255, g = 158, b = 143 }
warning = { r = 240, g = 207, b = 142 }
info = { r = 127, g = 207, b = 240 }
muted = { r = 127, g = 154, b = 156 }
table_header = { r = 139, g = 233, b = 198 }
table_border = { r = 35, g = 58, b = 63 }
line_number = { r = 127, g = 154, b = 156 }
tree_branch = { r = 112, g = 155, b = 159 }
tree_dir = { r = 127, g = 207, b = 240 }
tree_file = { r = 163, g = 182, b = 184 }
tree_ignored = { r = 127, g = 154, b = 156 }
tree_size = { r = 123, g = 152, b = 155 }
command_output = { r = 217, g = 232, b = 231 }
separator = { r = 38, g = 63, b = 68 }
help_header = { r = 127, g = 207, b = 240 }
help_section = { r = 139, g = 233, b = 198 }
help_example = { r = 158, g = 224, b = 168 }
teleport_name = { r = 127, g = 207, b = 240 }
alias_name = { r = 158, g = 235, b = 208 }
alias_command = { r = 127, g = 154, b = 156 }
git_branch = { r = 127, g = 207, b = 240 }
