[editor]
editor_bg = { r = 20, g = 31, b = 26 }
gutter_bg = { r = 13, g = 20, b = 17 }
status_bg = { r = 21, g = 82, b = 58 }
hint_bg = { r = 8, g = 12, b = 11 }
text_field_bg = { r = 54, g = 68, b = 62 }
sidebar_bg = { r = 7, g = 11, b = 9 }
sidebar_selected_bg = { r = 33, g = 49, b = 42 }
run_panel_bg = { r = 16, g = 24, b = 21 }
gutter_text = { r = 136, g = 147, b = 160 }
status_text = { r = 242, g = 245, b = 248 }
status_modified = { r = 255, g = 212, b = 125 }
hint_text = { r = 206, g = 138, b = 235 }
cursor_bg = { r = 208, g = 248, b = 235 }
