# ntc run aliases - Windows 10/11 (cmd.exe + PowerShell friendly)
# Import with: ral import ntc_ral/windows.ntc.ral
# ${x} is a parameter; ${x:-default} is optional; $*{x} keeps spaces.

[run_aliases]
# --- ntc workspace ---
bup = "backup create"
bup-list = "backup list"
bup-restore = "backup restore"
bup-undo = "backup undo"
cfgvdef = "cfg dv on && cfg intro_view on"
cfgvno = "cfg dv off && cfg fv off && cfg size all off && cfg intro_view off"
h = "cls && help"
x = "cls && clear"
v = "run cls && view --care --time -d ${x:-1}"
vf = "run cls && viewf -s --time --care --sort size"
vd = "run cls && viewd --care --time --size --sort size -d ${x:-1}"
u = "run cls && size --care --time && view --size --care --time --sort size -d 1"
vsz = "view --size --care --sort size --head 25"
tld = "tl dir ${x:-.}"
sz = "size --care -t"
zipdir = "arc create ${x}.zip ${x}"
unzip = "arc extract ${x}"
ziplist = "arc list ${x}"
servehttp = "serve files --port 8080"

# --- folders ---
updir = "cd .."
e = "start ."
home = "cd \"%USERPROFILE%\""
docs = "cd \"%USERPROFILE%/Documents\""
down = "cd \"%USERPROFILE%/Downloads\""
desk = "cd \"%USERPROFILE%/Desktop\""
pics = "cd \"%USERPROFILE%/Pictures\""
temp = "cd \"%TEMP%\""
appdata = "cd \"%APPDATA%\""
startup = "cd \"%APPDATA%/Microsoft/Windows/Start Menu/Programs/Startup\""

# --- apps and control panels ---
c = "code ."
t = "start taskmgr"
dvr = "start devmgmt.msc"
svc = "start services.msc"
reg = "start regedit"
control = "start control"
apps = "start appwiz.cpl"
netcpl = "start ncpa.cpl"
powercpl = "start powercfg.cpl"
envgui = "rundll32.exe sysdm.cpl,EditEnvironmentVariables"
recycle = "start shell:RecycleBinFolder"
hosts = "notepad C:/Windows/System32/drivers/etc/hosts"
sysinfo = "systeminfo"
drives = "wmic logicaldisk get name,size,freespace"

# --- power and session ---
shut = "shutdown /s /t 0"
restart = "shutdown /r /t 0"
logoff = "shutdown /l"
hibernate = "shutdown /h"
cancelshut = "shutdown /a"
lock = "rundll32.exe user32.dll,LockWorkStation"
sleep = "rundll32.exe powrprof.dll,SetSuspendState 0,1,0"
battery = "powercfg /batteryreport && start battery-report.html"

# --- network ---
ip = "ipconfig"
ipa = "ipconfig /all"
ipflush = "ipconfig /flushdns"
iprelease = "ipconfig /release"
iprenew = "ipconfig /renew"
wifi = "netsh wlan show profiles"
wifikey = "netsh wlan show profile name=${x} key=clear"
ports = "netstat -ano | findstr LISTENING"
portg = "netstat -ano | findstr ${x}"
pingg = "ping -t ${x}"

# --- processes ---
ps = "tasklist"
psg = "tasklist | findstr ${x}"
kill = "taskkill /F /IM ${x}"
runapp = "start ${x}"

# --- packages ---
wingetup = "winget upgrade --all"
wingets = "winget search ${x}"
wingeti = "winget install ${x}"
wingetl = "winget list"
cleanmgr = "cleanmgr"

# --- dev ---
py = "python"
pyt = "python ${x}"
pyv = "python -m venv venv"
pyact = "py_activate"
pydeact = "py_deactivate"
pipi = "pip install"
pipu = "pip uninstall"
npmi = "npm install -g"
npmu = "npm uninstall -g"
npml = "npm list -g --depth=0"
gst = "git status"
gl = "git log --oneline -n 20"
gd = "git diff"
ga = "git add ."
gcm = "git commit -m $*{x}"
gp = "git push"
gpl = "git pull"
gb = "git branch"
gco = "git checkout ${x}"
gcl = "git clone ${x}"
cb = "cargo build"
cbr = "cargo build --release"
cr = "cargo run"
ct = "cargo test"
cc = "cargo check"
clippy = "cargo clippy --all-targets -- -D warnings"
fmtall = "cargo fmt --all"
dps = "docker ps"
dpsa = "docker ps -a"
dc = "docker compose"
dcu = "docker compose up -d"
dcd = "docker compose down"
dcl = "docker compose logs -f"
now = "echo %DATE% %TIME%"

[run_alias_hints]
tld = "#x --hint-dir"
zipdir = "#x --hint-dir"
unzip = "#x --hint-ext zip"
pyt = "#x --select-ext py"
runapp = "#x --hint-all"
