# nuengcoder - NuengCoder mint blend with brighter ocean, lower grape, amber output, and lime files.
# ntc theme. Install with: ntc theme import ntc_theme/nuengcoder.ntc_theme

name = "nuengcoder"
author = "ntc"
description = "NuengCoder mint blend with brighter ocean, lower grape, amber output, and lime files"

[syntax]
keyword = { r = 145, g = 255, b = 210 }
string = { r = 169, g = 246, b = 191 }
comment = { r = 136, g = 147, b = 160 }
number = { r = 255, g = 212, b = 125 }
type = { r = 158, g = 226, b = 255 }
builtin = { r = 210, g = 175, b = 255 }
function = { r = 206, g = 138, b = 235 }
operator = { r = 216, g = 222, b = 230 }
punctuation = { r = 184, g = 194, b = 206 }
attribute = { r = 255, g = 212, b = 125 }
macro_token = { r = 210, g = 175, b = 255 }
regex = { r = 210, g = 175, b = 255 }
tag = { r = 158, g = 226, b = 255 }
constant = { r = 255, g = 212, b = 125 }
normal = { r = 242, g = 245, b = 248 }
muted = { r = 136, g = 147, b = 160 }
table_header = { r = 145, g = 255, b = 210 }
table_border = { r = 33, g = 49, b = 42 }
line_number = { r = 136, g = 147, b = 160 }

[shell]
prompt_bracket = { r = 158, g = 226, b = 255 }
prompt_path = { r = 206, g = 138, b = 235 }
prompt_watcher = { r = 255, g = 212, b = 125 }
prompt_arrow = { r = 145, g = 255, b = 210 }
ntc_command = { r = 255, g = 212, b = 125 }
txtf_file = { r = 190, g = 232, b = 145 }
ral_name = { r = 145, g = 255, b = 210 }
ral_command = { r = 255, g = 212, b = 125 }
ntc_sub_command = { r = 158, g = 226, b = 255 }
sub_sub_command = { r = 206, g = 138, b = 235 }
flag1 = { r = 255, g = 212, b = 125 }
flag2 = { r = 247, g = 233, b = 205 }
tp_name = { r = 206, g = 138, b = 235 }
tp_path = { r = 158, g = 226, b = 255 }
ral_ls_alias = { r = 158, g = 226, b = 255 }
tp_ls_tp_name = { r = 158, g = 226, b = 255 }
success = { r = 145, g = 255, b = 210 }
error = { r = 210, g = 175, b = 255 }
warning = { r = 255, g = 212, b = 125 }
info = { r = 206, g = 138, b = 235 }
muted = { r = 136, g = 147, b = 160 }
table_header = { r = 158, g = 226, b = 255 }
table_border = { r = 33, g = 49, b = 42 }
line_number = { r = 136, g = 147, b = 160 }
tree_branch = { r = 92, g = 157, b = 128 }
tree_dir = { r = 158, g = 226, b = 255 }
tree_file = { r = 190, g = 232, b = 145 }
tree_ignored = { r = 136, g = 147, b = 160 }
tree_size = { r = 210, g = 216, b = 222 }
command_output = { r = 255, g = 212, b = 125 }
separator = { r = 255, g = 210, b = 210 }
help_header = { r = 158, g = 226, b = 255 }
help_section = { r = 206, g = 138, b = 235 }
help_example = { r = 145, g = 255, b = 210 }
teleport_name = { r = 206, g = 138, b = 235 }
alias_name = { r = 208, g = 248, b = 235 }
alias_command = { r = 136, g = 147, b = 160 }
git_branch = { r = 158, g = 226, b = 255 }
git_added = { r = 145, g = 255, b = 210 }
git_modified = { r = 255, g = 212, b = 125 }
git_deleted = { r = 210, g = 175, b = 255 }
git_untracked = { r = 136, g = 147, b = 160 }
