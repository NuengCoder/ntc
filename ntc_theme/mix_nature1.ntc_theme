# mix_nature1 - Mint-forward blend of mint, ocean, grape, amber, and dusk.
# ntc theme. Install with: ntc theme import ntc_theme/mix_nature1.ntc_theme

name = "mix_nature1"
author = "ntc"
description = "Mint-forward blend of mint, ocean, grape, amber, and dusk"

[syntax]
keyword = { r = 128, g = 218, b = 184 }
string = { r = 147, g = 211, b = 169 }
comment = { r = 138, g = 149, b = 160 }
number = { r = 232, g = 181, b = 100 }
type = { r = 204, g = 144, b = 232 }
builtin = { r = 190, g = 152, b = 220 }
function = { r = 128, g = 188, b = 238 }
operator = { r = 184, g = 192, b = 200 }
punctuation = { r = 148, g = 158, b = 170 }
attribute = { r = 232, g = 181, b = 100 }
macro_token = { r = 190, g = 152, b = 220 }
regex = { r = 190, g = 152, b = 220 }
tag = { r = 204, g = 144, b = 232 }
constant = { r = 232, g = 181, b = 100 }
normal = { r = 217, g = 225, b = 229 }
muted = { r = 138, g = 149, b = 160 }
table_header = { r = 128, g = 218, b = 184 }
table_border = { r = 42, g = 55, b = 50 }
line_number = { r = 138, g = 149, b = 160 }

[shell]
