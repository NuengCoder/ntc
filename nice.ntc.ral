# ntc run aliases export
# Import with: ral import <file>

[run_aliases]
bup = "backup create"
bup-file = "cp ${x} ${x}.bak -f"
bup-list = "backup list"
c = "code ."
cfgvdef = "cfg dv on && cfg intro_view on"
cfgvno = "cfg dv off && cfg fv off && cfg size all off && cfg intro_view off"
closeos = "shutdown /s /t 0"
dvr = "start devmgmt.msc"
e = "start ."
h = "cls && help"
ip = "ipconfig"
n = "td add \"$*{x}\""
now = "echo %DATE% %TIME%"
npmi = "npm install -g"
npmu = "npm uninstall -g"
pipi = "pip install"
play = "start http://127.0.0.1:8080 && serve chess 8080"
pull = "backup restore"
pull-file = "cp ${x}.bak ${x} -f"
pyreq = "txtf requirements.txt"
pyt = "python ${x}"
pyv = "python -m venv venv"
rdm = "math rand(${x:-1},${y:-100})"
renpm = "npmu ${x} && npmi ${x}"
replace = "qur *.* -s \"$*{x}\" -rp \"$*{y}\""
rex = ".\\${x}"
rwk = "tp rm wk && tp add wk && pause && clear"
s = "start ${x}"
size_mode_off = "config fv off && config size off"
size_mode_on = "config size on && config fv on"
sv = "start services.msc"
t = "start taskmgr"
tb = "start shell:RecycleBinFolder"
u = "run cls && size --care --time && view --size --care --time --sort size -d 1"
v = "run cls && view --care --time -d ${x:-1}"
vd = "run cls && viewd --care --time --size --sort size -d ${x:-1}"
vf = "run cls && viewf -s --time --care --sort size"
vs = "views"
wifi = "netsh wlan show profiles"
wk = "tp to wk"
x = "cls && clear"
zip-exe = "arc create ${x}.zip ${x}.exe"

[run_alias_hints]
bup-file = "#x --hint-file"
pull-file = "#x --hint-ext-name bak"
pyt = "#x --select-ext py"
rex = "#x --hint-ext exe"
s = "#x --select-fd"
zip-exe = "#x --hint-ext-name exe"
