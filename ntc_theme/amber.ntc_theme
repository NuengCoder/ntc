command_output = { r = 214, g = 203, b = 184 }
separator = { r = 106, g = 96, b = 82 }
help_header = { r = 201, g = 168, b = 106 }
help_section = { r = 224, g = 184, b = 120 }
help_example = { r = 168, g = 192, b = 144 }
teleport_name = { r = 224, g = 184, b = 120 }
alias_name = { r = 202, g = 187, b = 130 }
alias_command = { r = 125, g = 114, b = 97 }
git_branch = { r = 201, g = 168, b = 106 }
