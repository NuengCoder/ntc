# dual_mint_ocean - Dual-accent mint and ocean theme with a cool teal editor.
# ntc theme. Install with: ntc theme import ntc_theme/dual_mint_ocean.ntc_theme

name = "dual_mint_ocean"
author = "ntc"
description = "Dual-accent mint and ocean theme with a cool teal editor"

[syntax]
keyword = { r = 139, g = 233, b = 198 }
string = { r = 158, g = 224, b = 168 }
comment = { r = 127, g = 154, b = 156 }
number = { r = 240, g = 207, b = 142 }
type = { r = 127, g = 207, b = 240 }
builtin = { r = 255, g = 158, b = 143 }
function = { r = 132, g = 224, b = 232 }
operator = { r = 196, g = 217, b = 216 }
punctuation = { r = 167, g = 192, b = 194 }
attribute = { r = 240, g = 207, b = 142 }
macro_token = { r = 139, g = 222, b = 186 }
regex = { r = 255, g = 171, b = 152 }
tag = { r = 127, g = 207, b = 240 }
constant = { r = 240, g = 207, b = 142 }
normal = { r = 217, g = 232, b = 231 }
muted = { r = 127, g = 154, b = 156 }
table_header = { r = 127, g = 207, b = 240 }
table_border = { r = 35, g = 58, b = 63 }
line_number = { r = 127, g = 154, b = 156 }

[shell]
prompt_bracket = { r = 127, g = 207, b = 240 }
prompt_path = { r = 139, g = 233, b = 198 }
prompt_watcher = { r = 240, g = 207, b = 142 }
prompt_arrow = { r = 158, g = 224, b = 168 }
ntc_command = { r = 240, g = 207, b = 142 }
txtf_file = { r = 158, g = 224, b = 168 }
ral_name = { r = 139, g = 233, b = 198 }
ral_command = { r = 240, g = 207, b = 142 }
ntc_sub_command = { r = 127, g = 207, b = 240 }
sub_sub_command = { r = 139, g = 222, b = 186 }
flag1 = { r = 240, g = 207, b = 142 }
flag2 = { r = 217, g = 201, b = 161 }
tp_name = { r = 127, g = 207, b = 240 }
tp_path = { r = 139, g = 233, b = 198 }
ral_ls_alias = { r = 127, g = 207, b = 240 }
tp_ls_tp_name = { r = 127, g = 207, b = 240 }
