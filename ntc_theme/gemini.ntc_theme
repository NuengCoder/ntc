error = { r = 242, g = 139, b = 130 }
warning = { r = 253, g = 214, b = 99 }
info = { r = 197, g = 138, b = 249 }
muted = { r = 154, g = 160, b = 166 }
table_header = { r = 138, g = 180, b = 248 }
table_border = { r = 39, g = 49, b = 65 }
line_number = { r = 154, g = 160, b = 166 }
tree_branch = { r = 138, g = 147, b = 163 }
tree_dir = { r = 197, g = 138, b = 249 }
tree_file = { r = 197, g = 206, b = 224 }
tree_ignored = { r = 154, g = 160, b = 166 }
tree_size = { r = 150, g = 161, b = 179 }
command_output = { r = 232, g = 234, b = 237 }
separator = { r = 48, g = 61, b = 80 }
help_header = { r = 197, g = 138, b = 249 }
help_section = { r = 138, g = 180, b = 248 }
help_example = { r = 126, g = 226, b = 184 }
teleport_name = { r = 197, g = 138, b = 249 }
alias_name = { r = 138, g = 180, b = 248 }
alias_command = { r = 154, g = 160, b = 166 }
git_branch = { r = 197, g = 138, b = 249 }
