# ntc run aliases - AlmaLinux (Linux, systemd, dnf)
# Import with: ral import ntc_ral/linux_alma.ntc.ral
# ${x} is a parameter; ${x:-default} is optional; $*{x} keeps spaces.

[run_aliases]
# --- ntc workspace ---
bup = "backup create"
bup-list = "backup list"
bup-restore = "backup restore"
bup-undo = "backup undo"
x = "clear"
v = "run clear && view --care --time -d ${x:-1}"
vf = "run clear && viewf -s --time --care --sort size"
vd = "run clear && viewd --care --time --size --sort size -d ${x:-1}"
u = "run clear && size --care --time && view --size --care --time --sort size -d 1"
vsz = "view --size --care --sort size --head 25"
tld = "tl dir ${x:-.}"
sz = "size --care -t"
zipdir = "arc create ${x}.zip ${x}"
untar = "arc extract ${x}"
ziplist = "arc list ${x}"
servehttp = "serve files --port 8080"

# --- folders ---
updir = "cd .."
e = "xdg-open ."
o = "xdg-open ${x}"
home = "cd ~"
docs = "cd ~/Documents"
down = "cd ~/Downloads"
desk = "cd ~/Desktop"
pics = "cd ~/Pictures"
temp = "cd /tmp"

# --- system info ---
kernel = "uname -a"
distro = "cat /etc/os-release"
uptime = "uptime"
who = "who"
df = "df -h"
du = "du -sh * | sort -h"
mem = "free -h"
disks = "lsblk -f"
usb = "lsusb"
pci = "lspci"
mounts = "mount | column -t"
battery = "cat /sys/class/power_supply/BAT*/capacity"
tempnow = "sensors"

# --- power and session ---
shut = "sudo shutdown -h now"
restart = "sudo reboot"
suspend = "systemctl suspend"
lock = "loginctl lock-session"
logout = "loginctl terminate-user $(id -un)"

# --- network ---
ip = "ip addr"
ipr = "ip route"
wifi = "nmcli device wifi list"
wifion = "nmcli radio wifi on"
wifioff = "nmcli radio wifi off"
flushdns = "sudo resolvectl flush-caches"
ports = "ss -tulpn"
portg = "ss -tulpn | grep ${x}"
pingg = "ping ${x}"

# --- services and logs ---
svc = "systemctl list-units --type=service --state=running"
svcs = "systemctl status ${x}"
svcr = "sudo systemctl restart ${x}"
svcstop = "sudo systemctl stop ${x}"
svcon = "sudo systemctl enable --now ${x}"
logs = "journalctl -xe"
logf = "journalctl -fu ${x}"

# --- processes ---
ps = "ps aux"
psg = "ps aux | grep -i ${x} | grep -v grep"
kill9 = "kill -9 ${x}"
topn = "top -o %CPU"

# --- files ---
ll = "ls -lah"
la = "ls -A"
lt = "ls -ltr"
chmodx = "chmod +x ${x}"
own = "sudo chown -R $(id -un) ${x}"
trash = "gio trash ${x}"
shred = "shred -zvu ${x}"
clipset = "xclip -selection clipboard < ${x}"
clipget = "xclip -selection clipboard -o"

# --- packages ---
dnfup = "sudo dnf upgrade --refresh -y"
dnfin = "sudo dnf install ${x}"
dnfrm = "sudo dnf remove ${x}"
dnfs = "dnf search ${x}"
dnfl = "dnf list installed"
dnfclean = "sudo dnf clean all"
pkgu = "sudo dnf check-update"
pkgi = "sudo dnf install ${x}"
pkgrm = "sudo dnf remove ${x}"
pkgs = "dnf search ${x}"
pkgl = "dnf list installed"


# --- dev ---
py = "python3"
pyt = "python3 ${x}"
pyv = "python3 -m venv venv"
pyact = "py_activate"
pydeact = "py_deactivate"
pipi = "pip3 install"
pipu = "pip3 uninstall"
npmi = "npm install -g"
npmu = "npm uninstall -g"
npml = "npm list -g --depth=0"
gst = "git status"
gl = "git log --oneline -n 20"
gd = "git diff"
ga = "git add ."
gcm = "git commit -m $*{x}"
gp = "git push"
gpl = "git pull"
gb = "git branch"
gco = "git checkout ${x}"
gcl = "git clone ${x}"
cb = "cargo build"
cbr = "cargo build --release"
cr = "cargo run"
ct = "cargo test"
cc = "cargo check"
clippy = "cargo clippy --all-targets -- -D warnings"
fmtall = "cargo fmt --all"
dps = "docker ps"
dpsa = "docker ps -a"
dc = "docker compose"
dcu = "docker compose up -d"
dcd = "docker compose down"
dcl = "docker compose logs -f"

[run_alias_hints]
tld = "#x --hint-dir"
zipdir = "#x --hint-dir"
untar = "#x --hint-ext tar.gz"
o = "#x --hint-all"
pyt = "#x --select-ext py"
chmodx = "#x --hint-file"
clipset = "#x --hint-file"
own = "#x --hint-dir"
