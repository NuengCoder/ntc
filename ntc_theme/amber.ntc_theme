# amber - Warm charcoal theme with honey amber accents.
# ntc theme. Install with: ntc theme import ntc_theme/amber.ntc_theme

name = "amber"
author = "ntc"
description = "Warm charcoal theme with honey amber accents"

[syntax]
keyword = { r = 216, g = 168, b = 95 }
string = { r = 168, g = 192, b = 144 }
comment = { r = 125, g = 114, b = 97 }
number = { r = 217, g = 160, b = 92 }
type = { r = 201, g = 168, b = 106 }
builtin = { r = 207, g = 143, b = 122 }
function = { r = 224, g = 184, b = 120 }
operator = { r = 192, g = 181, b = 162 }
punctuation = { r = 165, g = 154, b = 136 }
attribute = { r = 217, g = 160, b = 92 }
macro_token = { r = 213, g = 159, b = 104 }
regex = { r = 210, g = 149, b = 112 }
tag = { r = 201, g = 168, b = 106 }
constant = { r = 217, g = 160, b = 92 }
normal = { r = 214, g = 203, b = 184 }
muted = { r = 125, g = 114, b = 97 }
table_header = { r = 201, g = 168, b = 106 }
table_border = { r = 102, g = 92, b = 78 }
line_number = { r = 125, g = 114, b = 97 }

[shell]
prompt_bracket = { r = 201, g = 168, b = 106 }
