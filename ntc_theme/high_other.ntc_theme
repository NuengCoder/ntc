txtf_file = { r = 185, g = 245, b = 145 }
ral_name = { r = 255, g = 108, b = 205 }
ral_command = { r = 255, g = 218, b = 110 }
ntc_sub_command = { r = 190, g = 150, b = 255 }
sub_sub_command = { r = 105, g = 225, b = 255 }
flag1 = { r = 255, g = 218, b = 110 }
