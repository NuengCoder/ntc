tree_size = { r = 210, g = 216, b = 222 }
command_output = { r = 242, g = 245, b = 248 }
separator = { r = 49, g = 33, b = 43 }
help_header = { r = 190, g = 150, b = 255 }
help_section = { r = 105, g = 225, b = 255 }
help_example = { r = 185, g = 245, b = 145 }
teleport_name = { r = 105, g = 225, b = 255 }
alias_name = { r = 247, g = 197, b = 233 }
alias_command = { r = 136, g = 147, b = 160 }
git_branch = { r = 190, g = 150, b = 255 }
