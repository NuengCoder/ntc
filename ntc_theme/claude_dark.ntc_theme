tp_name = { r = 154, g = 184, b = 216 }
tp_path = { r = 232, g = 149, b = 110 }
ral_ls_alias = { r = 154, g = 184, b = 216 }
tp_ls_tp_name = { r = 154, g = 184, b = 216 }
