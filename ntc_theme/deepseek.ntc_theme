# deepseek - DeepSeek-inspired navy theme with electric blue and cyan accents.
# ntc theme. Install with: ntc theme import ntc_theme/deepseek.ntc_theme

name = "deepseek"
author = "ntc"
description = "DeepSeek-inspired navy theme with electric blue and cyan accents"

[syntax]
keyword = { r = 128, g = 158, b = 255 }
string = { r = 141, g = 236, b = 184 }
comment = { r = 145, g = 165, b = 204 }
number = { r = 255, g = 208, b = 120 }
type = { r = 95, g = 223, b = 255 }
builtin = { r = 185, g = 162, b = 255 }
function = { r = 109, g = 230, b = 247 }
operator = { r = 198, g = 216, b = 255 }
punctuation = { r = 168, g = 190, b = 230 }
attribute = { r = 255, g = 208, b = 120 }
macro_token = { r = 128, g = 158, b = 255 }
regex = { r = 255, g = 142, b = 160 }
tag = { r = 95, g = 223, b = 255 }
constant = { r = 255, g = 208, b = 120 }
normal = { r = 235, g = 242, b = 255 }
muted = { r = 145, g = 165, b = 204 }
table_header = { r = 95, g = 223, b = 255 }
table_border = { r = 31, g = 49, b = 90 }
line_number = { r = 145, g = 165, b = 204 }

[shell]
prompt_bracket = { r = 95, g = 223, b = 255 }
prompt_path = { r = 128, g = 158, b = 255 }
prompt_watcher = { r = 255, g = 208, b = 120 }
prompt_arrow = { r = 141, g = 236, b = 184 }
ntc_command = { r = 255, g = 208, b = 120 }
txtf_file = { r = 208, g = 224, b = 255 }
ral_name = { r = 128, g = 158, b = 255 }
ral_command = { r = 255, g = 208, b = 120 }
ntc_sub_command = { r = 95, g = 223, b = 255 }
sub_sub_command = { r = 109, g = 230, b = 247 }
flag1 = { r = 255, g = 208, b = 120 }
flag2 = { r = 168, g = 190, b = 230 }
tp_name = { r = 95, g = 223, b = 255 }
tp_path = { r = 128, g = 158, b = 255 }
ral_ls_alias = { r = 95, g = 223, b = 255 }
tp_ls_tp_name = { r = 95, g = 223, b = 255 }
success = { r = 128, g = 158, b = 255 }
error = { r = 255, g = 122, b = 138 }
warning = { r = 255, g = 208, b = 120 }
info = { r = 95, g = 223, b = 255 }
muted = { r = 145, g = 165, b = 204 }
table_header = { r = 128, g = 158, b = 255 }
table_border = { r = 31, g = 49, b = 90 }
line_number = { r = 145, g = 165, b = 204 }
tree_branch = { r = 112, g = 137, b = 184 }
tree_dir = { r = 95, g = 223, b = 255 }
tree_file = { r = 208, g = 224, b = 255 }
tree_ignored = { r = 145, g = 165, b = 204 }
tree_size = { r = 160, g = 181, b = 218 }
command_output = { r = 235, g = 242, b = 255 }
separator = { r = 37, g = 56, b = 99 }
help_header = { r = 95, g = 223, b = 255 }
help_section = { r = 128, g = 158, b = 255 }
help_example = { r = 141, g = 236, b = 184 }
teleport_name = { r = 95, g = 223, b = 255 }
alias_name = { r = 128, g = 158, b = 255 }
alias_command = { r = 145, g = 165, b = 204 }
git_branch = { r = 95, g = 223, b = 255 }
git_added = { r = 128, g = 158, b = 255 }
git_modified = { r = 255, g = 208, b = 120 }
git_deleted = { r = 255, g = 122, b = 138 }
