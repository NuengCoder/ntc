# dual_lime_violet - Dual-accent lime and violet theme with a dark violet editor.
# ntc theme. Install with: ntc theme import ntc_theme/dual_lime_violet.ntc_theme

name = "dual_lime_violet"
author = "ntc"
description = "Dual-accent lime and violet theme with a dark violet editor"

[syntax]
keyword = { r = 198, g = 232, b = 121 }
string = { r = 158, g = 225, b = 162 }
comment = { r = 158, g = 150, b = 180 }
number = { r = 255, g = 205, b = 124 }
type = { r = 184, g = 157, b = 255 }
builtin = { r = 255, g = 145, b = 158 }
function = { r = 220, g = 244, b = 165 }
operator = { r = 213, g = 206, b = 228 }
punctuation = { r = 184, g = 173, b = 202 }
attribute = { r = 255, g = 205, b = 124 }
macro_token = { r = 198, g = 232, b = 121 }
regex = { r = 240, g = 180, b = 188 }
tag = { r = 184, g = 157, b = 255 }
constant = { r = 255, g = 205, b = 124 }
normal = { r = 240, g = 236, b = 250 }
muted = { r = 158, g = 150, b = 180 }
table_header = { r = 184, g = 157, b = 255 }
table_border = { r = 49, g = 41, b = 70 }
line_number = { r = 158, g = 150, b = 180 }

[shell]
prompt_bracket = { r = 184, g = 157, b = 255 }
prompt_path = { r = 198, g = 232, b = 121 }
prompt_watcher = { r = 255, g = 205, b = 124 }
prompt_arrow = { r = 158, g = 225, b = 162 }
ntc_command = { r = 255, g = 205, b = 124 }
txtf_file = { r = 158, g = 225, b = 162 }
ral_name = { r = 198, g = 232, b = 121 }
ral_command = { r = 255, g = 205, b = 124 }
ntc_sub_command = { r = 184, g = 157, b = 255 }
sub_sub_command = { r = 220, g = 244, b = 165 }
flag1 = { r = 255, g = 205, b = 124 }
flag2 = { r = 184, g = 173, b = 202 }
tp_name = { r = 184, g = 157, b = 255 }
tp_path = { r = 198, g = 232, b = 121 }
ral_ls_alias = { r = 184, g = 157, b = 255 }
tp_ls_tp_name = { r = 184, g = 157, b = 255 }
success = { r = 198, g = 232, b = 121 }
error = { r = 255, g = 145, b = 158 }
warning = { r = 255, g = 205, b = 124 }
info = { r = 184, g = 157, b = 255 }
muted = { r = 158, g = 150, b = 180 }
table_header = { r = 198, g = 232, b = 121 }
table_border = { r = 49, g = 41, b = 70 }
line_number = { r = 158, g = 150, b = 180 }
tree_branch = { r = 143, g = 132, b = 171 }
tree_dir = { r = 184, g = 157, b = 255 }
tree_file = { r = 205, g = 195, b = 181 }
tree_ignored = { r = 158, g = 150, b = 180 }
tree_size = { r = 158, g = 150, b = 180 }
command_output = { r = 240, g = 236, b = 250 }
separator = { r = 56, g = 47, b = 79 }
help_header = { r = 184, g = 157, b = 255 }
help_section = { r = 198, g = 232, b = 121 }
help_example = { r = 158, g = 225, b = 162 }
teleport_name = { r = 184, g = 157, b = 255 }
alias_name = { r = 220, g = 244, b = 165 }
alias_command = { r = 158, g = 150, b = 180 }
git_branch = { r = 184, g = 157, b = 255 }
git_added = { r = 198, g = 232, b = 121 }
