error = { r = 240, g = 138, b = 128 }
warning = { r = 227, g = 190, b = 122 }
info = { r = 154, g = 184, b = 216 }
muted = { r = 179, g = 158, b = 136 }
table_header = { r = 232, g = 149, b = 110 }
table_border = { r = 58, g = 45, b = 35 }
line_number = { r = 179, g = 158, b = 136 }
tree_branch = { r = 176, g = 154, b = 131 }
tree_dir = { r = 154, g = 184, b = 216 }
tree_file = { r = 228, g = 216, b = 200 }
tree_ignored = { r = 179, g = 158, b = 136 }
tree_size = { r = 182, g = 162, b = 141 }
command_output = { r = 242, g = 233, b = 221 }
separator = { r = 69, g = 53, b = 40 }
help_header = { r = 154, g = 184, b = 216 }
help_section = { r = 232, g = 149, b = 110 }
help_example = { r = 167, g = 201, b = 138 }
teleport_name = { r = 154, g = 184, b = 216 }
alias_name = { r = 232, g = 149, b = 110 }
alias_command = { r = 179, g = 158, b = 136 }
git_branch = { r = 154, g = 184, b = 216 }
