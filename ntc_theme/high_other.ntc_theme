# high_other - Luminous multicolor theme with pink, cyan, violet, coral, and gold.
# ntc theme. Install with: ntc theme import ntc_theme/high_other.ntc_theme

name = "high_other"
author = "ntc"
description = "Luminous multicolor theme with pink, cyan, violet, coral, and gold"

[syntax]
keyword = { r = 255, g = 108, b = 205 }
string = { r = 200, g = 239, b = 137 }
comment = { r = 136, g = 147, b = 160 }
number = { r = 255, g = 218, b = 110 }
type = { r = 190, g = 150, b = 255 }
builtin = { r = 255, g = 145, b = 115 }
function = { r = 105, g = 225, b = 255 }
operator = { r = 216, g = 222, b = 230 }
punctuation = { r = 184, g = 194, b = 206 }
attribute = { r = 255, g = 218, b = 110 }
macro_token = { r = 255, g = 145, b = 115 }
regex = { r = 255, g = 160, b = 205 }
tag = { r = 190, g = 150, b = 255 }
constant = { r = 255, g = 218, b = 110 }
normal = { r = 242, g = 245, b = 248 }
muted = { r = 136, g = 147, b = 160 }
table_header = { r = 255, g = 108, b = 205 }
table_border = { r = 49, g = 33, b = 43 }
line_number = { r = 136, g = 147, b = 160 }

[shell]
prompt_bracket = { r = 190, g = 150, b = 255 }
prompt_path = { r = 105, g = 225, b = 255 }
