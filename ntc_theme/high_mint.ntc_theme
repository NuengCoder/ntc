txtf_file = { r = 163, g = 219, b = 163 }
ral_name = { r = 157, g = 225, b = 200 }
ral_command = { r = 225, g = 200, b = 158 }
ntc_sub_command = { r = 163, g = 220, b = 212 }
sub_sub_command = { r = 165, g = 218, b = 214 }
flag1 = { r = 225, g = 200, b = 158 }
flag2 = { r = 216, g = 201, b = 166 }
tp_name = { r = 165, g = 218, b = 214 }
tp_path = { r = 163, g = 220, b = 212 }
ral_ls_alias = { r = 163, g = 220, b = 212 }
tp_ls_tp_name = { r = 163, g = 220, b = 212 }
success = { r = 163, g = 219, b = 163 }
error = { r = 224, g = 158, b = 167 }
warning = { r = 225, g = 200, b = 158 }
info = { r = 165, g = 218, b = 214 }
muted = { r = 148, g = 168, b = 162 }
table_header = { r = 163, g = 220, b = 212 }
table_border = { r = 74, g = 94, b = 88 }
line_number = { r = 148, g = 168, b = 162 }
tree_branch = { r = 103, g = 136, b = 130 }
tree_dir = { r = 163, g = 220, b = 212 }
tree_file = { r = 156, g = 170, b = 166 }
tree_ignored = { r = 148, g = 168, b = 162 }
tree_size = { r = 104, g = 126, b = 119 }
command_output = { r = 200, g = 218, b = 213 }
separator = { r = 78, g = 98, b = 92 }
help_header = { r = 163, g = 220, b = 212 }
help_section = { r = 165, g = 218, b = 214 }
help_example = { r = 163, g = 219, b = 163 }
teleport_name = { r = 165, g = 218, b = 214 }
alias_name = { r = 164, g = 219, b = 196 }
alias_command = { r = 148, g = 168, b = 162 }
git_branch = { r = 163, g = 220, b = 212 }
