# dual_other - Dual-accent pink and cyan theme with violet, coral, and gold highlights.
# ntc theme. Install with: ntc theme import ntc_theme/dual_other.ntc_theme

name = "dual_other"
author = "ntc"
description = "Dual-accent pink and cyan theme with violet, coral, and gold highlights"

[syntax]
keyword = { r = 255, g = 110, b = 199 }
string = { r = 200, g = 240, b = 138 }
comment = { r = 139, g = 127, b = 150 }
number = { r = 255, g = 212, b = 121 }
type = { r = 192, g = 166, b = 255 }
builtin = { r = 255, g = 158, b = 122 }
function = { r = 111, g = 227, b = 245 }
operator = { r = 222, g = 210, b = 228 }
punctuation = { r = 196, g = 180, b = 205 }
attribute = { r = 255, g = 212, b = 121 }
macro_token = { r = 255, g = 158, b = 122 }
regex = { r = 255, g = 163, b = 220 }
tag = { r = 192, g = 166, b = 255 }
constant = { r = 255, g = 212, b = 121 }
normal = { r = 242, g = 236, b = 244 }
muted = { r = 156, g = 143, b = 166 }
table_header = { r = 255, g = 110, b = 199 }
table_border = { r = 47, g = 33, b = 51 }
line_number = { r = 139, g = 127, b = 150 }

[shell]
prompt_bracket = { r = 255, g = 110, b = 199 }
prompt_path = { r = 111, g = 227, b = 245 }
prompt_watcher = { r = 255, g = 212, b = 121 }
prompt_arrow = { r = 200, g = 240, b = 138 }
ntc_command = { r = 255, g = 212, b = 121 }
txtf_file = { r = 200, g = 240, b = 138 }
ral_name = { r = 255, g = 110, b = 199 }
ral_command = { r = 255, g = 212, b = 121 }
ntc_sub_command = { r = 111, g = 227, b = 245 }
sub_sub_command = { r = 168, g = 240, b = 247 }
flag1 = { r = 255, g = 212, b = 121 }
flag2 = { r = 242, g = 225, b = 184 }
tp_name = { r = 111, g = 227, b = 245 }
tp_path = { r = 255, g = 110, b = 199 }
ral_ls_alias = { r = 255, g = 110, b = 199 }
tp_ls_tp_name = { r = 255, g = 110, b = 199 }
success = { r = 200, g = 240, b = 138 }
error = { r = 255, g = 163, b = 220 }
warning = { r = 255, g = 212, b = 121 }
info = { r = 111, g = 227, b = 245 }
muted = { r = 156, g = 143, b = 166 }
table_header = { r = 255, g = 110, b = 199 }
table_border = { r = 47, g = 33, b = 51 }
line_number = { r = 139, g = 127, b = 150 }
tree_branch = { r = 168, g = 115, b = 154 }
tree_dir = { r = 111, g = 227, b = 245 }
tree_file = { r = 184, g = 169, b = 194 }
tree_ignored = { r = 139, g = 127, b = 150 }
tree_size = { r = 213, g = 203, b = 221 }
command_output = { r = 242, g = 236, b = 244 }
separator = { r = 58, g = 41, b = 64 }
help_header = { r = 255, g = 110, b = 199 }
help_section = { r = 111, g = 227, b = 245 }
help_example = { r = 200, g = 240, b = 138 }
teleport_name = { r = 111, g = 227, b = 245 }
alias_name = { r = 255, g = 163, b = 220 }
alias_command = { r = 156, g = 143, b = 166 }
git_branch = { r = 111, g = 227, b = 245 }
git_added = { r = 200, g = 240, b = 138 }
