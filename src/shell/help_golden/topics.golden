  view -fs, --filesize [min-size]        Show file sizes; with value, hide smaller files
  view -ds, --dirsize [min-size]         Show dir sizes; with value, hide smaller dirs
  view --sort size|char|ext              Sort children (dirs stay first)
  view --head <n>                        Show only first n tree lines
  view --tail <n>                        Show only last n tree lines
