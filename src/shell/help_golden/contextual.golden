=== scan ext ===
scan ext <ext...> [-d|--depth <n>] [-s|--size] [--care]
=== qur ===
qur <glob> [-s "pattern"] [-rp "new"] [-dp] [-d <n>] [-l <n>]
-s
--select
-rp
--replace
-dp
--display
-d
--depth
-l
--limit
=== qur *.* ===
qur <glob> -s "<pattern>" | -d <n> | -l <n>
=== qur *.* -s foo ===
qur <glob> -s "<pattern>" -dp | -rp "<new>" [-d <n>] [-l <n>]
