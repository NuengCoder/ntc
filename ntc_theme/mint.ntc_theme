# mint - Cool dark theme with fresh mint accents.
# ntc theme. Install with: ntc theme import ntc_theme/mint.ntc_theme

name = "mint"
author = "ntc"
description = "Cool dark theme with fresh mint accents"

[syntax]
keyword = { r = 143, g = 208, b = 184 }
string = { r = 168, g = 212, b = 168 }
comment = { r = 95, g = 115, b = 109 }
number = { r = 208, g = 184, b = 144 }
type = { r = 134, g = 196, b = 188 }
builtin = { r = 208, g = 146, b = 154 }
function = { r = 148, g = 200, b = 196 }
operator = { r = 168, g = 188, b = 182 }
punctuation = { r = 139, g = 159, b = 153 }
attribute = { r = 208, g = 184, b = 144 }
macro_token = { r = 166, g = 186, b = 174 }
regex = { r = 208, g = 159, b = 150 }
tag = { r = 134, g = 196, b = 188 }
constant = { r = 208, g = 184, b = 144 }
normal = { r = 192, g = 212, b = 206 }
muted = { r = 95, g = 115, b = 109 }
table_header = { r = 134, g = 196, b = 188 }
table_border = { r = 75, g = 93, b = 88 }
line_number = { r = 95, g = 115, b = 109 }

