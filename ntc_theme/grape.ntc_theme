# grape - Ripe grape dark theme with magenta accents.
# ntc theme. Install with: ntc theme import ntc_theme/grape.ntc_theme

name = "grape"
author = "ntc"
description = "Ripe grape dark theme with magenta accents"

[syntax]
keyword = { r = 192, g = 154, b = 224 }
string = { r = 168, g = 192, b = 168 }
comment = { r = 110, g = 102, b = 128 }
number = { r = 208, g = 184, b = 144 }
type = { r = 168, g = 160, b = 216 }
builtin = { r = 210, g = 154, b = 174 }
function = { r = 184, g = 160, b = 224 }
operator = { r = 183, g = 175, b = 197 }
punctuation = { r = 154, g = 146, b = 169 }
attribute = { r = 208, g = 184, b = 144 }
macro_token = { r = 198, g = 154, b = 206 }
regex = { r = 209, g = 164, b = 164 }
tag = { r = 168, g = 160, b = 216 }
constant = { r = 208, g = 184, b = 144 }
normal = { r = 207, g = 199, b = 220 }
muted = { r = 110, g = 102, b = 128 }
table_header = { r = 168, g = 160, b = 216 }
table_border = { r = 88, g = 81, b = 104 }
line_number = { r = 110, g = 102, b = 128 }

