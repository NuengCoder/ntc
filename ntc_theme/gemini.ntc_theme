# gemini - Dark Gemini-inspired theme with blue, purple, pink, and cyan accents.
# ntc theme. Install with: ntc theme import ntc_theme/gemini.ntc_theme

name = "gemini"
author = "ntc"
description = "Dark Gemini-inspired theme with blue, purple, pink, and cyan accents"

[syntax]
keyword = { r = 138, g = 180, b = 248 }
string = { r = 126, g = 226, b = 184 }
comment = { r = 154, g = 160, b = 166 }
number = { r = 253, g = 214, b = 99 }
type = { r = 197, g = 138, b = 249 }
builtin = { r = 242, g = 139, b = 130 }
function = { r = 124, g = 216, b = 255 }
operator = { r = 215, g = 220, b = 229 }
punctuation = { r = 174, g = 182, b = 194 }
attribute = { r = 253, g = 214, b = 99 }
macro_token = { r = 138, g = 180, b = 248 }
regex = { r = 255, g = 139, b = 203 }
tag = { r = 197, g = 138, b = 249 }
constant = { r = 253, g = 214, b = 99 }
normal = { r = 232, g = 234, b = 237 }
muted = { r = 154, g = 160, b = 166 }
table_header = { r = 197, g = 138, b = 249 }
table_border = { r = 39, g = 49, b = 65 }
line_number = { r = 154, g = 160, b = 166 }

[shell]
prompt_bracket = { r = 197, g = 138, b = 249 }
prompt_path = { r = 138, g = 180, b = 248 }
prompt_watcher = { r = 253, g = 214, b = 99 }
prompt_arrow = { r = 126, g = 226, b = 184 }
ntc_command = { r = 253, g = 214, b = 99 }
txtf_file = { r = 197, g = 206, b = 224 }
ral_name = { r = 138, g = 180, b = 248 }
ral_command = { r = 253, g = 214, b = 99 }
ntc_sub_command = { r = 197, g = 138, b = 249 }
sub_sub_command = { r = 124, g = 216, b = 255 }
flag1 = { r = 253, g = 214, b = 99 }
flag2 = { r = 174, g = 182, b = 194 }
tp_name = { r = 197, g = 138, b = 249 }
tp_path = { r = 138, g = 180, b = 248 }
ral_ls_alias = { r = 197, g = 138, b = 249 }
tp_ls_tp_name = { r = 197, g = 138, b = 249 }
