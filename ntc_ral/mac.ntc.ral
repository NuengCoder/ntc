# ntc run aliases - macOS (zsh, Homebrew, launchd)
# Import with: ral import ntc_ral/mac.ntc.ral
# ${x} is a parameter; ${x:-default} is optional; $*{x} keeps spaces.

[run_aliases]
# --- ntc workspace ---
bup = "backup create"
bup-list = "backup list"
bup-restore = "backup restore"
bup-undo = "backup undo"
x = "clear"
v = "run clear && view --care --time -d ${x:-1}"
vf = "run clear && viewf -s --time --care --sort size"
vd = "run clear && viewd --care --time --size --sort size -d ${x:-1}"
u = "run clear && size --care --time && view --size --care --time --sort size -d 1"
vsz = "view --size --care --sort size --head 25"
tld = "tl dir ${x:-.}"
sz = "size --care -t"
zipdir = "arc create ${x}.zip ${x}"
unzip = "arc extract ${x}"
ziplist = "arc list ${x}"
servehttp = "serve files --port 8080"

# --- folders ---
updir = "cd .."
e = "open ."
o = "open ${x}"
home = "cd ~"
docs = "cd ~/Documents"
down = "cd ~/Downloads"
desk = "cd ~/Desktop"
pics = "cd ~/Pictures"
temp = "cd /tmp"

# --- system info ---
sw = "sw_vers"
sysinfo = "system_profiler SPHardwareDataType"
disk = "diskutil list"
df = "df -h"
du = "du -sh * | sort -h"
ps = "ps aux"
ports = "lsof -iTCP -sTCP:LISTEN -P -n"
portg = "lsof -iTCP -sTCP:LISTEN -P -n | grep ${x}"
ip = "ifconfig"
ipaddr = "ipconfig getifaddr en0"
wifi = "networksetup -listpreferredwirelessnetworks en0"
flushdns = "sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
battery = "pmset -g batt"
thermal = "pmset -g therm"

# --- power and session ---
shut = "sudo shutdown -h now"
restart = "sudo shutdown -r now"
sleep = "pmset sleepnow"
lock = "pmset displaysleepnow"
caf = "caffeinate -d -t 3600"
shot = "screencapture -i ~/Desktop/screenshot.png"

# --- files ---
ll = "ls -lah"
la = "ls -A"
lt = "ls -ltr"
chmodx = "chmod +x ${x}"
trash = "mv ${x} ~/.Trash/"
clipset = "pbcopy < ${x}"
clipget = "pbpaste"

# --- Homebrew ---
brewup = "brew update && brew upgrade"
brewi = "brew install ${x}"
brews = "brew search ${x}"
brewl = "brew list"
brewclean = "brew cleanup"
brewdr = "brew doctor"
services = "brew services list"
svcs = "brew services start ${x}"
svcstop = "brew services stop ${x}"

# --- apps ---
c = "code ."
finder = "open ."
chrome = "open -a \"Google Chrome\" ${x}"
safari = "open -a Safari ${x}"
sim = "open -a Simulator"
xcode = "xcodebuild -version"

# --- dev ---
py = "python3"
pyt = "python3 ${x}"
pyv = "python3 -m venv venv"
pyact = "py_activate"
pydeact = "py_deactivate"
pipi = "pip3 install"
pipu = "pip3 uninstall"
npmi = "npm install -g"
npmu = "npm uninstall -g"
npml = "npm list -g --depth=0"
gst = "git status"
gl = "git log --oneline -n 20"
gd = "git diff"
ga = "git add ."
gcm = "git commit -m $*{x}"
gp = "git push"
gpl = "git pull"
gb = "git branch"
gco = "git checkout ${x}"
gcl = "git clone ${x}"
cb = "cargo build"
cbr = "cargo build --release"
cr = "cargo run"
ct = "cargo test"
cc = "cargo check"
clippy = "cargo clippy --all-targets -- -D warnings"
fmtall = "cargo fmt --all"
dps = "docker ps"
dpsa = "docker ps -a"
dc = "docker compose"
dcu = "docker compose up -d"
dcd = "docker compose down"
dcl = "docker compose logs -f"

[run_alias_hints]
tld = "#x --hint-dir"
zipdir = "#x --hint-dir"
unzip = "#x --hint-ext zip"
o = "#x --hint-all"
pyt = "#x --select-ext py"
chmodx = "#x --hint-file"
clipset = "#x --hint-file"
trash = "#x --hint-all"
svcs = "#x --hint-ext-name service"
