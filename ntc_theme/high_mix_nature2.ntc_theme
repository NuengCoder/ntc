# high_mix_nature2 - Luminous ocean-forward blend of mint, ocean, grape, amber, and dusk.
# ntc theme. Install with: ntc theme import ntc_theme/high_mix_nature2.ntc_theme

name = "high_mix_nature2"
author = "ntc"
description = "Luminous ocean-forward blend of mint, ocean, grape, amber, and dusk"

[syntax]
keyword = { r = 140, g = 210, b = 255 }
string = { r = 169, g = 246, b = 191 }
comment = { r = 136, g = 147, b = 160 }
number = { r = 255, g = 212, b = 125 }
type = { r = 145, g = 255, b = 210 }
builtin = { r = 210, g = 175, b = 255 }
function = { r = 232, g = 160, b = 255 }
operator = { r = 216, g = 222, b = 230 }
punctuation = { r = 184, g = 194, b = 206 }
attribute = { r = 255, g = 212, b = 125 }
macro_token = { r = 210, g = 175, b = 255 }
regex = { r = 210, g = 175, b = 255 }
tag = { r = 145, g = 255, b = 210 }
constant = { r = 255, g = 212, b = 125 }
normal = { r = 242, g = 245, b = 248 }
muted = { r = 136, g = 147, b = 160 }
table_header = { r = 140, g = 210, b = 255 }
table_border = { r = 33, g = 43, b = 49 }
line_number = { r = 136, g = 147, b = 160 }

