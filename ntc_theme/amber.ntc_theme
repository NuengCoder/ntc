ntc_command = { r = 217, g = 160, b = 92 }
txtf_file = { r = 168, g = 192, b = 144 }
ral_name = { r = 216, g = 168, b = 95 }
ral_command = { r = 217, g = 160, b = 92 }
ntc_sub_command = { r = 201, g = 168, b = 106 }
sub_sub_command = { r = 224, g = 184, b = 120 }
flag1 = { r = 217, g = 160, b = 92 }
flag2 = { r = 216, g = 171, b = 115 }
tp_name = { r = 224, g = 184, b = 120 }
tp_path = { r = 201, g = 168, b = 106 }
ral_ls_alias = { r = 201, g = 168, b = 106 }
tp_ls_tp_name = { r = 201, g = 168, b = 106 }
success = { r = 168, g = 192, b = 144 }
error = { r = 207, g = 143, b = 122 }
warning = { r = 217, g = 160, b = 92 }
info = { r = 224, g = 184, b = 120 }
muted = { r = 125, g = 114, b = 97 }
table_header = { r = 201, g = 168, b = 106 }
table_border = { r = 102, g = 92, b = 78 }
line_number = { r = 125, g = 114, b = 97 }
tree_branch = { r = 137, g = 123, b = 98 }
tree_dir = { r = 213, g = 187, b = 139 }
tree_file = { r = 152, g = 143, b = 128 }
tree_ignored = { r = 125, g = 114, b = 97 }
